# Neon pooled connection string. Set in Vercel, never commit a real URL.
DATABASE_URL=
# Public production origin, or http://localhost:4321 for local OAuth.
APP_ORIGIN=https://sparks.codezela.com
# At least 32 random characters. Generate: openssl rand -hex 32
SESSION_SECRET=
# Allowed Studio administrator email.
ADMIN_EMAIL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated immutable numeric GitHub user IDs permitted to publish.
GITHUB_ADMIN_IDS=
# Vercel Blob token for cover and inline image uploads.
BLOB_READ_WRITE_TOKEN=
# Only for localhost development. Uses embedded Postgres, never allowed in production.
LOCAL_STUDIO=false
# Optional: the copied original Google Analytics ID. Leave empty to disable.
PUBLIC_GA_ID=
