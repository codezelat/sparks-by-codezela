---
import type { ArticleSummary } from '../lib/content';
import { dateLabel } from '../lib/content';
import Media from './Media.astro';
import Icon from './Icon.astro';
interface Props {
  article: ArticleSummary;
}
const { article } = Astro.props;
---

<article
  class:list={['article-row', { 'without-image': !article.featureImage }]}
>
  {article.featureImage && (
    <a
      class="row-media"
      href={`/${article.slug}/`}
      tabindex="-1"
      aria-hidden="true"
    >
      <Media article={article} sizes="(max-width: 600px) 100px, 260px" />
    </a>
  )}
  <div class="row-content">
    <time datetime={article.publishedAt}>{dateLabel(article.publishedAt)}</time>
    <h2>
      <a href={`/${article.slug}/`}>{article.title}</a>
    </h2>
  </div>
  <a
    class="row-arrow"
    href={`/${article.slug}/`}
    tabindex="-1"
    aria-hidden="true"
  >
    <Icon />
  </a>
</article>
